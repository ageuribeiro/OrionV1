<Page x:Class="Orion.Views.UsuarioBuscar"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Orion.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="UsuarioBuscar"
      Background="White">

  <Grid>
    <StackPanel Margin="10">
      <StackPanel Margin="40,0,40,30">
        <Label Content="Nome, Email ou Username:" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,20"/>
        <TextBox x:Name="txtSearch" Text="{Binding Usuarios.Nome}" Height="20" />
      </StackPanel>
      <StackPanel Margin="40,0,40,30">
        <DataGrid x:Name="dgrVeiculos" ItemsSource="{Binding Usuarios}"/>
      </StackPanel>
      
      <Button Content="Buscar" Command="{Binding BuscarUsuarios}" Width="100" Height="30" Margin="0,25,0,0" RenderTransformOrigin="0.6,5.546" />
    </StackPanel>
  </Grid>
</Page>
